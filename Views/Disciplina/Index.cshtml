@model IEnumerable<Academico.Models.Disciplina>

@{
    ViewData["Title"] = "Disciplinas Cadastradas";
}

<div class="container mt-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <h2 class="glow-text text-white h3 mb-0 text-uppercase tracking-wider">Disciplinas Ativas</h2>
    </div>

    <div class="d-flex flex-column gap-3">
        @foreach (var disciplina in Model)
        {
            <div class="card bg-dark border-secondary shadow-lg hover-bat-row">
                <div class="card-body p-0">
                    <div class="row g-0">
                        
                        <div class="col-12 col-md-3 bg-black p-3 d-flex flex-column justify-content-center border-end-md border-secondary text-center text-md-start">
                            <span class="badge bg-secondary text-black fw-bold px-2 py-1 text-uppercase align-self-center align-self-md-start mb-2">
                                @disciplina.Periodo
                            </span>
                            <h3 class="text-white h5 mb-1 text-uppercase fw-bold">
                                @disciplina.Nome
                            </h3>
                            <small class="text-success font-monospace small fw-bold text-uppercase tracking-wider">
                                🛡️ @disciplina.Grau
                            </small>
                        </div>

                        <div class="col-12 col-md-6 p-3 bg-opacity-10 bg-black">
                            <div class="row g-3 text-white-50 small">
                                <div class="col-6 col-sm-3">
                                    <span class="d-block text-muted text-xs">CÓD. DIÁRIO</span>
                                    <strong class="text-white font-monospace">@disciplina.CodigoDiario</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="d-block text-muted text-xs">CÓD. DISCIPLINA</span>
                                    <strong class="text-white font-monospace">#@disciplina.CodigoDisciplina</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="d-block text-muted text-xs">HORÁRIO</span>
                                    <strong class="text-white">⏱️ @disciplina.Horario</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="d-block text-muted text-xs">TURNO</span>
                                    <strong class="text-white">🌙 @disciplina.Turno</strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="d-block text-muted text-xs">CARGA HORÁRIA</span>
                                    <strong class="text-white">📚 @disciplina.CargaHoraria<span>h</span></strong>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <span class="d-block text-muted text-xs">TOTAL AULAS</span>
                                    <strong class="text-white">🎬 @disciplina.TotalAulas Aulas</strong>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <span class="d-block text-muted text-xs">LOCAL DA AULA</span>
                                    <strong class="text-white font-monospace text-wrap">📍 @disciplina.LocalAula</strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-3 p-3 d-flex flex-column justify-content-center border-top border-top-md-0 border-secondary">
                            <span class="text-muted d-block text-xs tracking-wider">Docente Responsável</span>
                            <span class="text-white fw-bold h6 mb-0">
                                👨‍🏫 @(disciplina.Professor?.Nome ?? "Não atribuído")
                            </span>
                            <small class="text-white-50 font-monospace text-xs mt-1">
                                Etapas: @disciplina.QuantidadeEtapas
                            </small>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>