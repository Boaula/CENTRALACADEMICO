@model Academico.Models.DisciplinaViewModel;

@{
    ViewData["Title"] = "Cadastrar Disciplina";
}

<div class="container mt-2 pb-4">
    <div class="row justify-content-center mb-5">
        <div class="col-md-8"> <div class="card shadow-lg bg-dark border-secondary">
                <div class="card-header border-secondary bg-black">
                    <h2 class="glow-text text-white h4 mb-0">CADASTRAR NOVA DISCIPLINA</h2>
                </div>
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <form method="post" asp-action="CriarDisciplina">
                        
                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Periodo" class="form-label text-white-50">Período / Semestre</label>
                                
                                <select asp-for="Periodo" class="form-control form-select bg-black text-white border-secondary" asp-items="@ViewBag.Periodos">
                                    <option value="">-- Selecione o Período --</option>
                                </select>
                                
                                <span asp-validation-for="Periodo" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Nome" class="form-label text-white-50">Nome da Disciplina</label>
                                <input asp-for="Nome" type="text" class="form-control bg-black text-white border-secondary" placeholder="Ex: Programação WEB I">
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="Grau" class="form-label text-white-50">Grau</label>
                                <select asp-for="Grau" class="form-control form-select bg-black text-white border-secondary" asp-items="@ViewBag.Grau">
                                <option value="">-- Selecione o Grau --</option>
                                </select>
                                <span asp-validation-for="Grau" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-group mb-3">
                                <label asp-for="Turno" class="form-label text-white-50">Turno</label>
                                <input asp-for="Turno" type="text" class="form-control bg-black text-white border-secondary" placeholder="Ex: Noturno">
                                <span asp-validation-for="Turno" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="CargaHoraria" class="form-label text-white-50">Carga Horária (Horas)</label>
                                <input asp-for="CargaHoraria" type="number" class="form-control bg-black text-white border-secondary" placeholder="Ex: 68">
                                <span asp-validation-for="CargaHoraria" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label asp-for="TotalAulas" class="form-label text-white-50">Quantidade de Aulas</label>
                                <input asp-for="TotalAulas" type="number" class="form-control bg-black text-white border-secondary" placeholder="Ex: 80">
                                <span asp-validation-for="TotalAulas" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 form-group mb-3">
                                <label asp-for="Horario" class="form-label text-white-50">Horário</label>
                                <input asp-for="Horario" type="text" class="form-control bg-black text-white border-secondary" placeholder="Ex: 13:00 - 17:00">
                                <span asp-validation-for="Horario" class="text-danger"></span>
                            </div>
                            <div class="col-md-9 form-group mb-3">
                                <label asp-for="LocalAula" class="form-label text-white-50">Local da Aula</label>
                                <input asp-for="LocalAula" type="text" class="form-control bg-black text-white border-secondary" placeholder="Ex: SALA AULA A2 - Bloco A (CVD)">
                                <span asp-validation-for="LocalAula" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 form-group mb-3">
                                <label asp-for="QuantidadeEtapas" class="form-label text-white-50">Qtd. Etapas</label>
                                <input asp-for="QuantidadeEtapas" type="number" class="form-control bg-black text-white border-secondary" placeholder="Ex: 1">
                                <span asp-validation-for="QuantidadeEtapas" class="text-danger"></span>
                            </div>
                            <div class="col-md-9 form-group mb-3">
                                <label for="professorSelect" class="form-label text-white-50">Professor Responsável</label>
                                <select asp-for="ProfessorId" id="professorSelect" class="form-control form-select bg-black text-white border-secondary" asp-items="@ViewBag.Professor">
                                    <option value="">-- Selecione um Docente --</option>
                                </select>
                                <span asp-validation-for="ProfessorId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-metallic fw-bold mt-3">CADASTRAR DISCIPLINA</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>