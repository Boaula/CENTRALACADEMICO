@model Aluno

@{
    ViewData["Title"] = "Editar Aluno - Donet";
}

<div class="container mt-3 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg bg-dark border-secondary">
                <div class="card-header border-secondary bg-black">
                    <h2 class="glow-text text-white h4 mb-0">ATUALIZAR CADASTRO: @Model.Nome.ToUpper()</h2>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="AtualizarAluno">
                        
                        <!-- IMPORTANTE: Campo ID oculto para o banco saber quem atualizar -->
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Nome" class="form-label text-white-50">Nome Completo</label>
                                <input asp-for="Nome" class="form-control bg-black text-white border-secondary">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Cpf" class="form-label text-white-50">CPF</label>
                                <input asp-for="Cpf" class="form-control bg-black text-white border-secondary" id="cpfInput">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DataNascimento" class="form-label text-white-50">Nascimento</label>
                                <input asp-for="DataNascimento" type="date" class="form-control bg-black text-white border-secondary">
                            </div>

                            <div class="col-md-12 mb-4">
                                <label asp-for="Curso" class="form-label text-white-50">Curso Acadêmico</label>
                                <select asp-for="Curso" class="form-select bg-black text-white border-secondary">
                                    <option value="TADS">Análise e Desenv. de Sistemas (TADS)</option>
                                    <option value="Agronomia Integral">Agronomia - Integral</option>
                                    <option value="Agronomia Noturno">Agronomia - Noturno</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-metallic fw-bold">SALVAR ALTERAÇÕES</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Cancelar e Voltar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>