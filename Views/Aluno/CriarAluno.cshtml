@model Aluno

@{
    ViewData["Title"] = "Cadastrar Aluno - Donet";
}

<div class="container mt-3 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header border-secondary bg-dark">
                    <h2 class="glow-text text-white h4 mb-0">REGISTRO DE DISCENTE</h2>
                </div>
                <div class="card-body">
                    <form method="post" asp-action="CriarAluno">
                        
                        <div class="row">
                            <!-- Nome Completo -->
                            <div class="col-md-12 mb-3">
                                <label asp-for="Nome" class="form-label text-dark">Nome Completo</label>
                                <input asp-for="Nome" class="form-control bg-dark text-white border-secondary" placeholder="Digite o nome do aluno">
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>

                            <!-- CPF -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cpf" class="form-label text-dark">CPF</label>
                                <input asp-for="Cpf" class="form-control bg-dark text-white border-secondary" id="cpfInput" placeholder="000.000.000-00">
                                <span asp-validation-for="Cpf" class="text-danger small"></span>
                            </div>

                            <!-- Data de Nascimento -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="DataNascimento" class="form-label text-dark">Data de Nascimento</label>
                                <input asp-for="DataNascimento" type="date" class="form-control bg-dark text-white border-secondary">
                                <span asp-validation-for="DataNascimento" class="text-danger small"></span>
                            </div>

                            <!-- Curso -->
                            <div class="col-md-12 mb-4">
                                <label asp-for="Curso" class="form-label text-dark">Curso Acadêmico</label>
                                <select asp-for="Curso" class="form-select bg-dark text-white border-secondary">
                                    <option value="" selected disabled>Selecione o curso...</option>
                                    <option value="TADS">Análise e Desenv. de Sistemas (TADS)</option>
                                    <option value="Agronomia Integral">Agronomia - Integral</option>
                                    <option value="Agronomia Noturno">Agronomia - Noturno</option>
                                </select>
                                <span asp-validation-for="Curso" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-metallic fw-bold">EFETUAR CADASTRO</button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Voltar para Listagem</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>  

    <script>
        $(document).ready(function () {
            // Aplica a máscara no campo que tem o id 'cpfInput'
            $('#cpfInput').mask('000.000.000-00', {reverse: false});
        });
    </script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}