@model List<Academico.Models.Aluno>;
@{
    ViewData["Title"] = "Perfil Aluno";
}

<div class="container mt-5 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <h2 class="glow-text text-white h3 mb-0 text-uppercase tracking-wider">Editar Alunos</h2>
        <a asp-action="CriarAluno" class="btn btn-success btn-metallic fw-bold shadow-sm">+ NOVO ALUNO</a>
    </div>
    @foreach(Aluno item in Model)
    {
    <div class="card mb-4 w-100 shadow-lg bg-dark border-secondary mt-5">
            <div class="row g-0">
                <!-- Coluna da Imagem com fundo contrastante -->
                <div class="col-md-3 d-flex align-items-center justify-content-center bg-black rounded-start">
                    <img src="~/img/avatar.png" class="img-fluid p-3" alt="Avatar" style="max-height: 150px; opacity: 0.8;">
                </div>
                
                <div class="col-md-9">
                    <div class="card-body h-100 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Nome com o efeito de brilho que você já usa -->
                            <h5 class="card-title glow-text text-white mb-3">DISCENTE: @item.Nome.ToUpper()</h5>
                            
                            <div class="row">
                                <div class="col-sm-6">
                                    <p class="card-text text-secondary mb-1">
                                        <small class="text-white fw-bold">NASCIMENTO:</small> 
                                        @item.DataNascimento.ToString("dd/MM/yyyy")
                                    </p>
                                    <p class="card-text text-secondary">
                                        <small class="text-white fw-bold">CURSO:</small> @item.Curso
                                    </p>
                                </div>
                                <div class="col-sm-6">
                                    <p class="card-text text-secondary mb-1">
                                        <small class="text-white fw-bold">MATRÍCULA:</small> @item.Matricula
                                    </p>
                                    <p class="card-text text-secondary">
                                        <small class="text-white fw-bold">SITUAÇÃO:</small> <span class="text-info">REGULAR</span>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Botões alinhados ao final -->
                        <div class="mt-3 d-flex justify-content-end gap-2">
                            <a class="btn btn-outline-info btn-sm" asp-action="AtualizarAluno" asp-route-id="@item.Id">
                                EDITAR
                            </a>
                            <a class="btn btn-danger btn-metallic btn-sm fw-bold" 
                            asp-action="ExcluirAluno" 
                            asp-controller="Aluno" 
                            asp-route-id="@item.Id">
                                EXCLUIR
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
