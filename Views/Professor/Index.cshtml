@model List<Academico.Models.Professor>;
@{
    ViewData["Title"] = "Perfil Professor";
}

@foreach(Professor item in Model)
{
    <div class="card mb-3 w-100 mt-5" >
    <div class="row g-0">
        <div class="col-md-4 w-30">
        <img src="img/avatar.png" class="img-fluid rounded-start" alt="Avatar">
        </div>
        <div class="col-md-8">
        <div class="card-body h-100 d-flex flex-column justify-content-around">
            <p class="card-text">Nome: @item.Nome</p>
            <p class="card-text">Data Nascimento: @item.DataNascimento.Day/@item.DataNascimento.Month/@item.DataNascimento.Year</p>
            <p class="card-text">Curso: @item.Area</p>
            <p class="card-text">Matrícula: @item.Siape</p>
            <div>
            <a class="btn btn-danger" asp-action="ExcluirProfessor"
                asp-controller="Professor"
                asp-route-id="@item.Id">
                Exluir
            </a>
            </div>
        </div>
        </div>
    </div>
    </div>
}
