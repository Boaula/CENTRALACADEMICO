@model List<Academico.Models.Professor>;
@{
    ViewData["Title"] = "Perfil Professor";
}
<div class="container mt-5 pb-5">
    @foreach(Professor item in Model)
    {
    <div class="card mb-4 w-100 shadow-lg bg-dark border-secondary">
        <div class="row g-0">
            <!-- Coluna da Imagem com ajuste de proporção -->
            <div class="col-md-3 d-flex align-items-center justify-content-center bg-black rounded-start">
                <img src="~/img/avatar.png" class="img-fluid p-3" alt="Avatar" style="max-height: 150px; opacity: 0.8;">
            </div>
            
            <div class="col-md-9">
                <div class="card-body h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="card-title glow-text text-white mb-3">DOCENTE: @item.Nome.ToUpper()</h5>
                        <div class="row">
                            <div class="col-sm-6">
                                <p class="card-text text-secondary">
                                    <small class="text-white fw-bold">ÁREA:</small> @item.Area
                                </p>
                            </div>
                            <div class="col-sm-6">
                                <p class="card-text text-secondary">
                                    <small class="text-white fw-bold">STATUS:</small> <span class="text-success">ATIVO</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
</div>
