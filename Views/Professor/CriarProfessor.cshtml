@model Professor

<form method="post" asp-action="CriarProfessor">
  <div class="form-group">
    <label for="formGroupExampleInput">Nome</label>
    <input asp-for="Nome" type="text" class="form-control" id="formGroupExampleInput" placeholder="Nome e sobre nome do Professor">
  </div>
  <div class="form-group">
      <label for="cpfInput">CPF</label>
      <input asp-for="Cpf" type="text" class="form-control" id="cpfInput" placeholder="000.000.000-00">
      <span asp-validation-for="Cpf" class="text-danger"></span>
  </div>
  <div class="form-group">
    <label for="siape">Siape</label>
    <input asp-for="Siape" type="text" class="form-control" id="siape" />
  </div>
  <div class="form-group">
    <label for="formGroupExampleInput2">Data de Nascimento</label>
    <input asp-for="DataNascimento" type="date" class="form-control" id="formGroupExampleInput2" placeholder="Another input placeholder">
  </div>
  <div class="form-group">
    <label for="formGroupExampleInput2">Área</label>
    <select asp-for="Area" class="form-control">
        <option id="1">Computação</option>
        <option id="2">Agronomia</option>
        <option id="3">Matemática</option>
    </select>
  </div>
  <button class="mt-5 btn btn-success">Cadastrar</button>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <script>
        $(document).ready(function () {
            // Aplica a máscara no campo que tem o id 'cpfInput'
            $('#cpfInput').mask('000.000.000-00', {reverse: false});
        });
    </script>
    
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}